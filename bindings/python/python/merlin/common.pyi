from . import ErrorCode as ErrorCode
from . import RunControl as RunControl
from collections.abc import Sequence
from .downstream import FullLoopSweepPlan
from .upstream import Simulation as UpstreamSimulation
__version__: str

class RetainedFootprint:
    """Rust payload quantities; excludes bookkeeping and Python copies, not RSS."""
    @property
    def payload_bytes(self) -> int: ...
    @property
    def ordered_entries(self) -> int: ...
    @property
    def shared_roots(self) -> int: ...

class Project:
    @staticmethod
    def from_bytes(data: bytes) -> Project: ...
    @staticmethod
    def from_file(path: str) -> Project: ...
    @property
    def direction(self) -> str: ...
    @property
    def original_document(self) -> bytes: ...
    def to_json(self) -> str: ...
    def downstream_plan(self) -> FullLoopSweepPlan: ...
    def upstream_simulation(self) -> UpstreamSimulation: ...
    @staticmethod
    def collection_info(projects: Sequence[Project]) -> dict[str, object]: ...
