"""MERLIN upstream declarations; adapted source namespaces and shared control."""
from typing import Optional
from . import ApiError as ApiError
from .common import ErrorCode as ErrorCode, RunControl as CommonRunControl
from .common import RetainedFootprint

__version__: str


class UcdCapture:
    @staticmethod
    def from_mac_management(bytes: bytes) -> UcdCapture: ...
    @staticmethod
    def from_source_json(bytes: bytes) -> UcdCapture: ...
    def to_source_json(self) -> str: ...
    def original_bytes(self) -> bytes: ...
    def original_sha256(self) -> str: ...
    def to_json(self) -> str: ...

class Waveform:
    def __init__(self, spacing_khz: int, prefix: int, rolloff: int, frame_symbols: int, bandwidth_hz: int) -> None: ...

class PreEqCapture:
    @staticmethod
    def from_pnm(bytes: bytes) -> PreEqCapture: ...
    @staticmethod
    def from_source_json(bytes: bytes) -> PreEqCapture: ...
    def to_source_json(self) -> str: ...
    def original_bytes(self) -> bytes: ...
    def original_sha256(self) -> str: ...
    def coefficients(self) -> list[tuple[float, float]]: ...
    def to_json(self) -> str: ...

class RxmerCapture:
    @staticmethod
    def from_pnm(bytes: bytes) -> RxmerCapture: ...
    @staticmethod
    def from_source_json(bytes: bytes) -> RxmerCapture: ...
    def to_source_json(self) -> str: ...
    def original_bytes(self) -> bytes: ...
    def original_sha256(self) -> str: ...
    def raw_readings(self) -> bytes: ...
    def readings_db(self) -> list[Optional[float]]: ...
    def ccap_id_text(self) -> Optional[str]: ...
    def pre_eq_enabled(self) -> Optional[bool]: ...
    def to_json(self) -> str: ...

class Minislot:
    def __init__(self, first_carrier: int, loading: int, pilot_pattern: int) -> None: ...

class Profile:
    def __init__(self, id: int, iuc: int, seed: int, minislots: list[Minislot]) -> None: ...

class SyntheticGrant:
    def __init__(self, id: int, profile_id: int, epoch_sample: int, first_frame: int, frames: int, minislots: list[int]) -> None: ...

class UsConfiguration:
    def __init__(self, waveform: Waveform, profiles: list[Profile], grant: SyntheticGrant, excluded: Optional[list[int]] = None) -> None: ...

class ReceiverConfig:
    def __init__(self, estimator: str = "frame_flat_ls", variance: float = 0.02, power_floor: float = 1e-12, iterations: int = 50, maximum_gap: int = 64) -> None: ...

class PreEqBank:
    def coefficients(self) -> list[tuple[float, float]]: ...
    @property
    def generation(self) -> int: ...
    @staticmethod
    def unity(config: UsConfiguration) -> PreEqBank: ...
    @staticmethod
    def normalized(config: UsConfiguration, coefficients: list[tuple[float, float]], generation: int) -> PreEqBank: ...

class ReceiverObservationPolicy:
    def __init__(self, maximum_frames: int = 0, maximum_scalar_slots: int = 0) -> None: ...
    def info(self) -> dict: ...
    def with_soft_metrics(self, policy: SoftObservationPolicy) -> ReceiverObservationPolicy: ...

class SoftObservationPolicy:
    def __init__(self, maximum_cells: int = 0, maximum_words: int = 0, maximum_word_llrs: int = 0) -> None: ...
    def info(self) -> dict: ...

class ChannelConfig:
    def __init__(self, taps: Optional[list[tuple[float, float]]] = None, noise_variance: float = 0.0, noise_seed: Optional[bytes] = None, delay_samples: int = 0, phase_radians: float = 0.0, frequency_offset_hz: float = 0.0) -> None: ...

class ExperimentConfig:
    def __init__(self, us_configuration: UsConfiguration, source_seed: int, receiver: Optional[ReceiverConfig] = None, pre_eq: Optional[PreEqBank] = None, channel: Optional[ChannelConfig] = None, rxmer: Optional[RxmerPlayback] = None, pre_eq_updates: Optional[PreEqPlayback] = None, leading_guard_samples: int = 0, trailing_guard_samples: int = 0) -> None: ...

class ExperimentOptions:
    def __init__(self, grants: int = 1, maximum_samples: int = 16777216, chunk_samples: int = 4096, timeout_ms: int = 30000, retained_points: int = 4096, retained_taps: Optional[list[str]] = None) -> None: ...

class ExperimentPreview:
    @property
    def profile_ids(self) -> list[int]: ...
    @property
    def source_bits(self) -> int: ...
    def to_json(self) -> str: ...

class RunControl:
    def __init__(self, cancellation: Optional[CommonRunControl] = None) -> None: ...
    def retained_footprint(self) -> RetainedFootprint: ...
    def cancel(self) -> None: ...
    def is_cancelled(self) -> bool: ...
    def pause(self) -> None: ...
    def resume(self) -> None: ...
    def progress_json(self) -> str: ...

class QamSnapshot:
    @property
    def values(self) -> list[tuple[float, float]]: ...
    def to_json(self) -> str: ...

class SpectrumSnapshot:
    def to_json(self) -> str: ...
    @property
    def frequency_hz(self) -> list[float]: ...
    @property
    def power_per_hz(self) -> list[float]: ...
    @property
    def first_sample(self) -> int: ...

class BatchReport:
    def retained_footprint(self) -> RetainedFootprint: ...
    def qam_constellation(self, tap_name: str = "RxEqualized", loading: int = 4, maximum_points: int = 4096, maximum_references: int = 4096) -> dict: ...
    def qam_pairing(self, left: str = "TxGrid", right: str = "RxEqualized", loading: Optional[int] = None, maximum_pairs: int = 4096) -> dict: ...
    def soft_observations(self) -> dict: ...
    def soft_cells(self, first_index: int = 0, maximum_cells: int = 32, maximum_llrs: int = 4096) -> dict: ...
    def soft_word(self, retained_index: int = 0, maximum_llrs: int = 32768) -> dict: ...
    def receiver_observations(self) -> dict: ...
    def receiver_estimate(self, retained_index: int = 0, first_carrier: int = 0, carrier_count: int = 0, maximum_points: int = 4096) -> dict: ...
    def configured_response(self, source: str = "physical_channel", grant_symbol: int = 0, first_carrier: int = 0, carrier_count: int = 0, maximum_points: int = 4096, include_impulse: bool = False) -> dict: ...
    def verification(self) -> dict: ...
    def fec_summary(self) -> dict: ...
    def fec_words(self, grant_index: int = 0, first_word: int = 0, maximum_words: int = 1, max_decision_bits: int = 262144) -> dict: ...
    @property
    def status(self) -> str: ...
    @property
    def reference_recovered(self) -> bool: ...
    @property
    def bit_errors(self) -> int: ...
    @property
    def ber(self) -> Optional[float]: ...
    @property
    def compared_source_bits(self) -> int: ...
    @property
    def generated_source_bits(self) -> int: ...
    def to_json(self) -> str: ...
    def qam(self, tap_name: str, loading: Optional[int] = None, maximum: int = 4096) -> QamSnapshot: ...
    def spectrum(self, tap_name: str, spacing_khz: int) -> SpectrumSnapshot: ...

class Simulation:
    def retained_footprint(self) -> RetainedFootprint: ...
    def set_receiver_observation_policy(self, policy: ReceiverObservationPolicy) -> None: ...
    def receiver_observation_policy(self) -> ReceiverObservationPolicy: ...
    def configured_response(self, source: str = "physical_channel", grant_symbol: int = 0, first_carrier: int = 0, carrier_count: int = 0, maximum_points: int = 4096, include_impulse: bool = False) -> dict: ...
    def resource_grid(self, frame_index: int = 0, first_symbol: int = 0, symbol_count: int = 1, first_carrier: int = 0, carrier_count: int = 0, max_cells: int = 16384) -> ResourceGridSnapshot: ...
    def configure_measured_json(self, bytes: bytes) -> None: ...
    def __init__(self, options: Optional[ExperimentOptions] = None) -> None: ...
    def configure(self, config: ExperimentConfig) -> None: ...
    def configure_document(self, document: ConfigurationDocument) -> None: ...
    def configure_json(self, bytes: bytes) -> None: ...
    def set_options(self, options: ExperimentOptions) -> None: ...
    def options(self) -> ExperimentOptions: ...
    def configuration(self) -> Optional[ExperimentConfig]: ...
    def document(self) -> Optional[ConfigurationDocument]: ...
    def preview(self) -> ExperimentPreview: ...
    def run(self) -> BatchReport: ...
    def run_with_control(self, control: RunControl) -> BatchReport: ...
    def batch_report_retained_bound(self) -> RetainedFootprint: ...
    def run_with_control_bounded(self, control: RunControl, limit: RetainedFootprint) -> BatchReport: ...

class SyntheticRxmer:
    def __init__(self, config: UsConfiguration, id: int, mer_db: list[Optional[float]]) -> None: ...
class RxmerPlayback:
    def __init__(self, config: UsConfiguration, sources: list[SyntheticRxmer], policy: str = "single", offsets: Optional[list[int]] = None) -> None: ...
    def at_json(self, symbol: int) -> str: ...
class ProbeReference:
    def __init__(self, id: int, bank_id: int) -> None: ...
class PreEqEvent:
    @staticmethod
    def snapshot(id: int, symbol: int, bank: PreEqBank) -> PreEqEvent: ...
    @staticmethod
    def initialize(id: int, symbol: int, base_bank: int, probe: int, updates: list[tuple[int, tuple[float, float]]]) -> PreEqEvent: ...
    @staticmethod
    def adjust(id: int, symbol: int, base_bank: int, probe: int, updates: list[tuple[int, tuple[float, float]]]) -> PreEqEvent: ...
class PreEqPlayback:
    def __init__(self, config: UsConfiguration, initial_id: int, initial: PreEqBank, events: list[PreEqEvent], probes: list[ProbeReference]) -> None: ...
    def coefficients(self, symbol: int) -> list[tuple[float, float]]: ...

class ConfigurationDocument:
    def original_bytes(self) -> Optional[bytes]: ...
    def original_sha256(self) -> Optional[str]: ...
    @staticmethod
    def from_json(bytes: bytes) -> ConfigurationDocument: ...
    def inventory(self) -> list[str]: ...
    def to_json(self) -> str: ...

class ResourceGridSnapshot:
    def to_json(self) -> str: ...
